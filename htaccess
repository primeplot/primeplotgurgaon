# Enable clean URLs (remove .html extension)
RewriteEngine On

# 301 redirect old flat plot URLs to new /plot/ URLs (SEO — avoid duplicate content)
RewriteRule ^50-gaj-plot-in-gurgaon/?$ /plot/50-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^100-gaj-plot-in-gurgaon/?$ /plot/100-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^150-gaj-plot-in-gurgaon/?$ /plot/150-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^200-gaj-plot-in-gurgaon/?$ /plot/200-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^300-gaj-plot-in-gurgaon/?$ /plot/300-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^400-gaj-plot-in-gurgaon/?$ /plot/400-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^500-gaj-plot-in-gurgaon/?$ /plot/500-gaj-plot-in-gurgaon [R=301,L]

# 301 redirect brief old /plots/ (folder) URLs to new /plot/ (SEO — avoid duplicate content)
RewriteRule ^plots/(.*)$ /plot/$1 [R=301,L]

# Serve the .html file when someone requests the URL without extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
