
# ==========================================
# Prime Plot Gurgaon - .htaccess
# Place in public_html/.htaccess
# ==========================================

RewriteEngine On

# ------------------------------------------
# 1. Redirect old plot URLs to /plots/
# ------------------------------------------

RewriteRule ^50-gaj-plot-in-gurgaon/?$ /plots/50-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^100-gaj-plot-in-gurgaon/?$ /plots/100-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^150-gaj-plot-in-gurgaon/?$ /plots/150-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^200-gaj-plot-in-gurgaon/?$ /plots/200-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^300-gaj-plot-in-gurgaon/?$ /plots/300-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^400-gaj-plot-in-gurgaon/?$ /plots/400-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^500-gaj-plot-in-gurgaon/?$ /plots/500-gaj-plot-in-gurgaon [R=301,L]

# ------------------------------------------
# 2. Redirect legacy /plot/ URLs to /plots/
# ------------------------------------------

RewriteRule ^plot/100-gaj-plot-in-gurgaon/?$ /plots/100-gaj-plot-in-gurgaon [R=301,L]
RewriteRule ^plot/200-gaj-plot-in-gurgaon/?$ /plots/200-gaj-plot-in-gurgaon [R=301,L]

# ------------------------------------------
# 3. Redirect old blog-detail URLs
#    to the current clean blog URLs
# ------------------------------------------

RewriteRule ^blog-detail/gurgaon-plot-price-2026\.html$ /blogs/gurgaon-plot-price-2026 [R=301,L]
RewriteRule ^blog-detail/investment-in-property-in-gurgaon\.html$ /blogs/investment-property-in-gurgaon [R=301,L]

# ------------------------------------------
# 4. Redirect old blog slug to corrected slug
# ------------------------------------------

RewriteRule ^blogs/investment-in-property-in-gurgaon/?$ /blogs/investment-property-in-gurgaon [R=301,L]

# ------------------------------------------
# 5. Serve existing extensionless URLs
#    using their matching .html files
# ------------------------------------------

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [END]

# ------------------------------------------
# 6. Browser caching
# ------------------------------------------

<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------
# 7. Security headers
# ------------------------------------------

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>
